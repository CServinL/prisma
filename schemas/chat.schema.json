{
  "$defs": {
    "AssetMediaNode": {
      "description": "A media artifact too large/binary to inline (jpg, pdf) -- stored as a\nvault-relative path served via vault/assets/, never base64-inlined into\nthe .sess file. Split from `InlineMediaNode` because the two are\ngenuinely different shapes (`value` vs. `asset_path`) -- same reasoning\n`CitedClaimNode`/`InferenceNode` were split on, not one class with two\nfields where exactly one is always None. `pdf` is the one kind that also\nhas a promotion path to a real vault Note (see VaultService.promote_\nattachment_to_note) -- PDF text is worth extracting/indexing, unlike a\nbare jpg.",
      "properties": {
        "asset_path": {
          "title": "Asset Path",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "jpg",
            "pdf"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "asset_path"
      ],
      "title": "AssetMediaNode",
      "type": "object"
    },
    "ChatRole": {
      "enum": [
        "user",
        "assistant"
      ],
      "title": "ChatRole",
      "type": "string"
    },
    "CitedClaimNode": {
      "description": "A claim traceable to specific vault document(s) -- `citation`/\n`paraphrase`/`attribution`/`relational` share this shape (all have real\n`sources`, a meaningful `faithfulness_checked`), unlike `InferenceNode`\nbelow, which structurally has neither. See docs/ontologia.md Axiom 16.\n`citation` (verbatim quote) and `paraphrase` (close restatement) were\nsplit from a single merged `citation` value in schema v4 -- see\n_migrate_chat_v3_to_v4.",
      "properties": {
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "faithfulness_checked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faithfulness Checked"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "claim",
          "default": "claim",
          "title": "Kind",
          "type": "string"
        },
        "qualifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Qualifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rebuts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebuts"
        },
        "relation": {
          "enum": [
            "citation",
            "paraphrase",
            "attribution",
            "relational"
          ],
          "title": "Relation",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "warrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/WarrantNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "index",
        "claim_text",
        "relation"
      ],
      "title": "CitedClaimNode",
      "type": "object"
    },
    "ContentFormat": {
      "enum": [
        "md",
        "html",
        "svg",
        "latex"
      ],
      "title": "ContentFormat",
      "type": "string"
    },
    "InferenceNode": {
      "description": "A claim that's the model's own reasoning, traceable to no specific\nvault document -- structurally distinct from CitedClaimNode (no\n`sources`, nothing for `faithfulness_checked` to check), not the same\nshape with empty fields.",
      "properties": {
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "inference",
          "default": "inference",
          "title": "Kind",
          "type": "string"
        },
        "qualifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Qualifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rebuts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rebuts"
        },
        "warrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/WarrantNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "index",
        "claim_text"
      ],
      "title": "InferenceNode",
      "type": "object"
    },
    "InlineMediaNode": {
      "description": "A media artifact whose content is small, text-based, and stored\ninline -- svg/latex/drawio are all XML or plain-text source, one shape\nfor all three since they're structurally identical, not a class per\nformat. See `AssetMediaNode` for the genuinely different binary case.",
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "svg",
            "latex",
            "drawio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "InlineMediaNode",
      "type": "object"
    },
    "Qualifier": {
      "description": "Toulmin model's epistemic-strength modifier on a claim -- `tentative`\ndoubles as \"this is a hypothesis, not yet established.\" See\ndocs/concepts/chat-session-graph.md's Argumentation structure section.",
      "enum": [
        "certain",
        "probable",
        "possible",
        "tentative"
      ],
      "title": "Qualifier",
      "type": "string"
    },
    "RecallRef": {
      "description": "A `RECALL` hit -- a pointer to another node elsewhere in a session\ngraph, never a duplicate of its content (see ADR-019's storage-vs-\ncontext distinction). Resolved/dereferenced only in the in-memory\ncontext assembly for the turn that recalled it.",
      "properties": {
        "chat_slug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Slug"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_kind": {
          "title": "Node Kind",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "node_kind"
      ],
      "title": "RecallRef",
      "type": "object"
    },
    "RichContent": {
      "properties": {
        "format": {
          "$ref": "#/$defs/ContentFormat",
          "default": "md"
        },
        "rendered_html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendered Html"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "RichContent",
      "type": "object"
    },
    "ThinkingNode": {
      "description": "One reasoning step, off the main line (`TurnNode.thoughts`) -- the\nsequentialthinking-motivated shape (see ADR-019/chat-session-graph.md).\nPopulated by the THINK: tool (chat_tools.py/chat_agent.py) when the\nactive model is configured with `has_native_reasoning = false`.\n`revises`/`branches_from` are schema-only for now -- nothing generates a\nTHINK: line referencing another thought's id yet.",
      "properties": {
        "branches_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branches From"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revises": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revises"
        },
        "thought": {
          "title": "Thought",
          "type": "string"
        },
        "thought_number": {
          "title": "Thought Number",
          "type": "integer"
        }
      },
      "required": [
        "thought",
        "thought_number"
      ],
      "title": "ThinkingNode",
      "type": "object"
    },
    "ToolCallNode": {
      "description": "One tool invocation, off the main line (`TurnNode.tool_calls`) --\nunlike v1's `ToolCallRecord`, `result` is persisted, not discarded, so a\nlater turn can `RECALL` it instead of only ever re-running the tool.",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolCallNode",
      "type": "object"
    },
    "TurnNode": {
      "properties": {
        "alternates": {
          "items": {
            "$ref": "#/$defs/TurnNode"
          },
          "title": "Alternates",
          "type": "array"
        },
        "attached_slugs": {
          "items": {
            "type": "string"
          },
          "title": "Attached Slugs",
          "type": "array"
        },
        "attachments": {
          "items": {
            "discriminator": {
              "mapping": {
                "drawio": "#/$defs/InlineMediaNode",
                "jpg": "#/$defs/AssetMediaNode",
                "latex": "#/$defs/InlineMediaNode",
                "pdf": "#/$defs/AssetMediaNode",
                "svg": "#/$defs/InlineMediaNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InlineMediaNode"
              },
              {
                "$ref": "#/$defs/AssetMediaNode"
              }
            ]
          },
          "title": "Attachments",
          "type": "array"
        },
        "claims": {
          "items": {
            "discriminator": {
              "mapping": {
                "claim": "#/$defs/CitedClaimNode",
                "inference": "#/$defs/InferenceNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CitedClaimNode"
              },
              {
                "$ref": "#/$defs/InferenceNode"
              }
            ]
          },
          "title": "Claims",
          "type": "array"
        },
        "content": {
          "$ref": "#/$defs/RichContent"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media": {
          "items": {
            "discriminator": {
              "mapping": {
                "drawio": "#/$defs/InlineMediaNode",
                "jpg": "#/$defs/AssetMediaNode",
                "latex": "#/$defs/InlineMediaNode",
                "pdf": "#/$defs/AssetMediaNode",
                "svg": "#/$defs/InlineMediaNode"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InlineMediaNode"
              },
              {
                "$ref": "#/$defs/AssetMediaNode"
              }
            ]
          },
          "title": "Media",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "recalls": {
          "items": {
            "$ref": "#/$defs/RecallRef"
          },
          "title": "Recalls",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/ChatRole"
        },
        "thoughts": {
          "items": {
            "$ref": "#/$defs/ThinkingNode"
          },
          "title": "Thoughts",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCallNode"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "TurnNode",
      "type": "object"
    },
    "WarrantNode": {
      "description": "Toulmin model's Warrant -- the reasoning bridge explaining *why* a\nclaim's grounds (`sources`) support that specific claim, often left\nimplicit in informal writing but required explicit in formal academic\nargument. `backing` is the Toulmin Backing: support for the warrant\nitself, structurally identical to `sources` (a list of vault-node\nreferences), so it's a field here rather than its own node type.\nSchema support only -- nothing populates this yet. See\ndocs/concepts/chat-session-graph.md's Argumentation structure section.",
      "properties": {
        "backing": {
          "items": {
            "type": "string"
          },
          "title": "Backing",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "WarrantNode",
      "type": "object"
    }
  },
  "properties": {
    "context_slugs": {
      "items": {
        "type": "string"
      },
      "title": "Context Slugs",
      "type": "array"
    },
    "context_tokens_max": {
      "default": 0,
      "title": "Context Tokens Max",
      "type": "integer"
    },
    "context_tokens_used": {
      "default": 0,
      "title": "Context Tokens Used",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "excerpt_regenerating": {
      "default": false,
      "title": "Excerpt Regenerating",
      "type": "boolean"
    },
    "excerpt_slug": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt Slug"
    },
    "excerpt_summary_html": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt Summary Html"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/TurnNode"
      },
      "title": "Messages",
      "type": "array"
    },
    "model": {
      "default": "llama3",
      "title": "Model",
      "type": "string"
    },
    "modified_at": {
      "format": "date-time",
      "title": "Modified At",
      "type": "string"
    },
    "node_type": {
      "const": "chat",
      "default": "chat",
      "title": "Node Type",
      "type": "string"
    },
    "path": {
      "format": "path",
      "title": "Path",
      "type": "string"
    },
    "pinned_turns": {
      "items": {
        "type": "integer"
      },
      "title": "Pinned Turns",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "title": "Chat",
  "type": "object"
}
