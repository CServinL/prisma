{
  "description": "A claim traceable to specific vault document(s) -- `citation`/\n`attribution`/`relational` share this shape (all have real `sources`, a\nmeaningful `faithfulness_checked`), unlike `InferenceNode` below, which\nstructurally has neither. See docs/ontologia.md Axiom 16.",
  "properties": {
    "claim_text": {
      "title": "Claim Text",
      "type": "string"
    },
    "faithfulness_checked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Faithfulness Checked"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "index": {
      "title": "Index",
      "type": "integer"
    },
    "kind": {
      "const": "claim",
      "default": "claim",
      "title": "Kind",
      "type": "string"
    },
    "relation": {
      "enum": [
        "citation",
        "attribution",
        "relational"
      ],
      "title": "Relation",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "index",
    "claim_text",
    "relation"
  ],
  "title": "CitedClaimNode",
  "type": "object"
}
